@using TrendClothing.Utility
@inject IHttpContextAccessor httpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrendClothing</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TrendClothing.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile-navbar.css" asp-append-version="true" />



    <!-- TOAST CSS -->
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)

    @* CSS REF *@
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.16/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/1.1.3/sweetalert.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-royal-dark desktop-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">TrendClothing</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>

                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>



                        @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">
                                    Content Management
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Category" asp-action="Index">Category</a>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="ProductType" asp-action="Index">Product Type</a>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Brand" asp-action="Index">Brand</a>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Color" asp-action="Index">Color</a>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Size" asp-action="Index">Size</a>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Product" asp-action="Index">Product</a>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="ProductVariant" asp-action="Index">Product Variant</a>
                                </div>
                            </li>
                        }

                        @if (User.IsInRole(SD.Role_Admin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">
                                    User Management
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="User" asp-action="Index">User</a>
                                </div>
                            </li>
                        }

                        @if (User.Identity.IsAuthenticated)
                        {
                            var cartCount = httpContextAccessor.HttpContext.Session
                            .GetInt32(SD.Ss_cartSessionCount) ?? 0;

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area="Customer"
                                   asp-controller="Order"
                                   asp-action="Index">
                                    My Orders
                                </a>
                            </li>

                            <li class="nav-item position-relative">
                                <a class="nav-link" asp-area="Customer" asp-controller="Cart" asp-action="Index">
                                    <i class="fa fa-shopping-cart fs-5"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle
                                            badge rounded-pill bg-danger">
                                        @cartCount
                                    </span>
                                </a>
                            </li>

                        }

                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-3">
                                <a asp-area="Customer"
                                   asp-controller="Profile"
                                   asp-action="Index"
                                   class="profile-avatar"
                                   title="My Profile">
                                    @User.Identity.Name.Substring(0, 1).ToUpper()
                                </a>
                            </li>
                        }

                        <partial name="_LoginPartial" />
                    </ul>



                </div>
            </div>
        </nav>
        <!-- ================= MOBILE NAVBAR ================= -->
        <nav class="mobile-navbar">
            <div class="mobile-nav-left">
                <button id="openMobileMenu" class="mobile-menu-btn">
                    <i class="fa fa-bars"></i>
                </button>

            </div>

            <div class="mobile-nav-center">
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="mobile-logo">
                    TrendClothing
                </a>
            </div>

            <div class="mobile-nav-right">

                @if (User.Identity.IsAuthenticated)
                {
                    var cartCount = httpContextAccessor.HttpContext.Session
                    .GetInt32(SD.Ss_cartSessionCount) ?? 0;

                    <a asp-area="Customer"
                       asp-controller="Cart"
                       asp-action="Index"
                       class="mobile-cart">
                        <i class="fa fa-shopping-cart"></i>
                        <span class="cart-badge">@cartCount</span>
                    </a>

                    <a asp-area="Customer"
                       asp-controller="Profile"
                       asp-action="Index"
                       class="mobile-profile">
                        @User.Identity.Name.Substring(0, 1).ToUpper()
                    </a>
                }
                else
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Register"
                       class="mobile-auth-btn register-btn">
                        Register
                    </a>

                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="mobile-auth-btn login-btn">
                        Login
                    </a>
                }

            </div>


        </nav>

    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <div id="mobileDrawer" class="mobile-drawer">
        <div class="drawer-header">
            <span>Menu</span>
            <button id="closeMobileMenu">&times;</button>
        </div>

        <ul class="drawer-links">

            <!-- COMMON -->
            <li>
                <a asp-area="" asp-controller="Home" asp-action="Index">Home
            <i class="fa fa-home"></i> 
            </a></li>
            <li>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy
                    <i class="fa fa-lock"></i>
            </a></li>

            @if (User.Identity.IsAuthenticated)
            {
                <li><a asp-area="Customer" asp-controller="Order" asp-action="Index">My Orders</a></li>
                <li><a asp-area="Customer" asp-controller="Profile" asp-action="Index">My Profile</a></li>
            }

            <!-- ================= ADMIN / EMPLOYEE ================= -->
            @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
            {
                <li class="drawer-dropdown">
                    <span class="drawer-toggle">
                        Content Management
                        <i class="fa fa-chevron-down"></i>
                    </span>

                    <ul class="drawer-submenu">
                        <li><a asp-area="Admin" asp-controller="Category" asp-action="Index">Category</a></li>
                        <li><a asp-area="Admin" asp-controller="ProductType" asp-action="Index">Product Type</a></li>
                        <li><a asp-area="Admin" asp-controller="Brand" asp-action="Index">Brand</a></li>
                        <li><a asp-area="Admin" asp-controller="Color" asp-action="Index">Color</a></li>
                        <li><a asp-area="Admin" asp-controller="Size" asp-action="Index">Size</a></li>
                        <li><a asp-area="Admin" asp-controller="Product" asp-action="Index">Product</a></li>
                        <li><a asp-area="Admin" asp-controller="ProductVariant" asp-action="Index">Product Variant</a></li>
                    </ul>
                </li>
            }

            <!-- ================= ADMIN ONLY ================= -->
            @if (User.IsInRole(SD.Role_Admin))
            {
                <li class="drawer-dropdown">
                    <span class="drawer-toggle">
                        User Management
                        <i class="fa fa-chevron-down"></i>
                    </span>

                    <ul class="drawer-submenu">
                        <li><a asp-area="Admin" asp-controller="User" asp-action="Index">Users</a></li>
                    </ul>
                </li>
            }

            @if (User.Identity.IsAuthenticated)
            {
                <li class="drawer-logout">
                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          method="post">
                        <button type="submit" class="logout-btn">
                            <i class="fa fa-sign-out-alt"></i>
                            Logout
                        </button>
                    </form>
                </li>
            }
            else
            {
                <li><partial name="_LoginPartial" /></li>
            }


        </ul>

    </div>

    <div id="drawerOverlay" class="drawer-overlay"></div>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - TrendClothing
        </div>
    </footer>

    <!-- TOAST DIV -->
    <div id="toast" class="toast"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/mobile-navbar.js" asp-append-version="true"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- TOAST JS -->
    <script src="~/js/toast.js" asp-append-version="true"></script>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            showToast(
                '@Html.Raw(TempData["ToastMessage"])',
                '@TempData["ToastColor"]'
            );

        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>