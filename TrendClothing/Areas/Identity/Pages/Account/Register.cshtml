@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tc-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="tc-auth-page">

    <!-- LEFT BRAND PANEL -->
    <div class="tc-auth-left">
        <a href="/" class="tc-auth-left__brand">TrendClothing</a>

        <div class="tc-auth-left__body">
            <p class="tc-auth-left__eyebrow">Join Us Today</p>
            <h1 class="tc-auth-left__title">Hello,<br />Friend.</h1>
            <p class="tc-auth-left__sub">Create your account and start shopping with TrendClothing.</p>

            <a asp-page="./Login"
               asp-route-returnUrl="@Model.ReturnUrl"
               class="tc-auth-left__action">
                Already have an account? →
            </a>
        </div>

        <div style="font-size:12px; color:rgba(255,255,255,0.25);">© TrendClothing</div>
    </div>

    <!-- RIGHT FORM PANEL -->
    <div class="tc-auth-right">
        <div class="tc-auth-form-wrap">

            <h2>Create Account</h2>
            <p class="tc-auth-sub">Fill in your details to get started</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:16px; font-size:13px;"></div>

                <div class="tc-auth-field">
                    <input asp-for="Input.Email" placeholder=" " autocomplete="username" required />
                    <label>Email address</label>
                    <span asp-validation-for="Input.Email" class="tc-auth-error"></span>
                </div>

                <div class="tc-auth-phone-row">
                    <select asp-for="Input.CountryCode">
                        <option value="+91">🇮🇳 +91</option>
                        <option value="+1">🇺🇸 +1</option>
                        <option value="+44">🇬🇧 +44</option>
                        <option value="+971">🇦🇪 +971</option>
                    </select>
                    <div class="tc-auth-field">
                        <input asp-for="Input.PhoneNumber" placeholder=" " />
                        <label>Phone number</label>
                        <span asp-validation-for="Input.PhoneNumber" class="tc-auth-error"></span>
                    </div>
                </div>

                <div class="tc-auth-field">
                    <input asp-for="Input.Name" placeholder=" " required />
                    <label>Full name</label>
                </div>

                <div class="tc-auth-field">
                    <input asp-for="Input.Address" placeholder=" " />
                    <label>Address</label>
                </div>

                <div class="tc-auth-two-col" style="margin-bottom:20px;">
                    <div class="tc-auth-field">
                        <input asp-for="Input.City" placeholder=" " />
                        <label>City</label>
                    </div>
                    <div class="tc-auth-field">
                        <input asp-for="Input.State" placeholder=" " />
                        <label>State</label>
                    </div>
                </div>

                <div class="tc-auth-field">
                    <input asp-for="Input.PostalCode" placeholder=" " />
                    <label>Postal code</label>
                </div>

                <div class="tc-auth-field">
                    <input asp-for="Input.Password" type="password" placeholder=" " autocomplete="new-password" required />
                    <label>Password</label>
                    <span asp-validation-for="Input.Password" class="tc-auth-error"></span>
                </div>

                <div class="tc-auth-field">
                    <input asp-for="Input.ConfirmPassword" type="password" placeholder=" " autocomplete="new-password" required />
                    <label>Confirm password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="tc-auth-error"></span>
                </div>

                <button type="submit" class="tc-auth-submit">Create Account</button>

                <div class="tc-auth-footer-link">
                    Already have an account? <a asp-page="./Login">Sign in</a>
                </div>
            </form>

            <!-- ✅ Social buttons — Create Account ke neeche -->
            <div style="margin-top:24px;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
                    <div style="flex:1;height:1px;background:var(--tc-border-dark);"></div>
                    <span style="font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--tc-gray-3);">Or register with</span>
                    <div style="flex:1;height:1px;background:var(--tc-border-dark);"></div>
                </div>

                <div style="display:flex;flex-direction:column;gap:10px;">
                    <form asp-area="Identity"
                          asp-page="/Account/ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">
                        <button type="submit" name="provider" value="Google"
                                style="width:100%;display:flex;align-items:center;justify-content:center;gap:10px;padding:11px 20px;border-radius:24px;border:1.5px solid var(--tc-border-dark);background:var(--tc-surface);color:var(--tc-black);font-size:13px;font-weight:600;font-family:var(--tc-font-body);cursor:pointer;transition:all 0.2s;">
                            <img src="~/Images/google.svg" alt="Google" style="width:18px;height:18px;" />
                            Continue with Google
                        </button>
                    </form>

                    <form asp-area="Identity"
                          asp-page="/Account/ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">
                        <button type="submit" name="provider" value="Facebook"
                                style="width:100%;display:flex;align-items:center;justify-content:center;gap:10px;padding:11px 20px;border-radius:24px;border:1.5px solid var(--tc-border-dark);background:var(--tc-surface);color:var(--tc-black);font-size:13px;font-weight:600;font-family:var(--tc-font-body);cursor:pointer;transition:all 0.2s;">
                            <img src="~/Images/facebook.svg" alt="Facebook" style="width:18px;height:18px;" />
                            Continue with Facebook
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
