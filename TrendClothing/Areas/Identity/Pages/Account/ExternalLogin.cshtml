@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Complete Registration";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tc-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="tc-auth-page">

    <!-- LEFT BRAND PANEL -->
    <div class="tc-auth-left">
        <a href="/" class="tc-auth-left__brand">TrendClothing</a>

        <div class="tc-auth-left__body">
            <p class="tc-auth-left__eyebrow">Almost There</p>
            <h1 class="tc-auth-left__title">Complete<br />Your Profile.</h1>
            <p class="tc-auth-left__sub">Just a few more details and you're all set to start shopping.</p>

            <a asp-page="./Login" class="tc-auth-left__action">
                Already have an account? →
            </a>
        </div>

        <div style="font-size:12px; color:rgba(255,255,255,0.25);">© TrendClothing</div>
    </div>

    <!-- RIGHT FORM PANEL -->
    <div class="tc-auth-right">
        <div class="tc-auth-form-wrap">

            <h2>Complete Profile</h2>
            <p class="tc-auth-sub">Fill in your details to finish registration</p>

            <form asp-page-handler="Confirmation"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"
                     style="margin-bottom:16px;font-size:13px;"></div>

                <div class="tc-auth-field">
                    <input asp-for="Input.Name" placeholder=" " required />
                    <label>Full Name</label>
                </div>

                <div class="tc-auth-field">
                    <input asp-for="Input.Email" placeholder=" " readonly
                           style="background:var(--tc-bg);color:var(--tc-gray-2);cursor:not-allowed;" />
                    <label>Email (from @Model.ProviderDisplayName)</label>
                </div>

                <div class="tc-auth-field">
                    <input asp-for="Input.Address" placeholder=" " />
                    <label>Address</label>
                </div>

                <div class="tc-auth-two-col" style="margin-bottom:20px;">
                    <div class="tc-auth-field">
                        <input asp-for="Input.City" placeholder=" " />
                        <label>City</label>
                    </div>
                    <div class="tc-auth-field">
                        <input asp-for="Input.State" placeholder=" " />
                        <label>State</label>
                    </div>
                </div>

                <div class="tc-auth-field">
                    <input asp-for="Input.PostalCode" placeholder=" " />
                    <label>Postal Code</label>
                </div>

                <button type="submit" class="tc-auth-submit">
                    Complete Registration
                </button>

                <div class="tc-auth-footer-link">
                    Already have an account? <a asp-page="./Login">Sign in</a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
