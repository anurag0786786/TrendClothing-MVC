@model TrendClothing.Models.ViewModels.ProfileVM

@section Styles {
    <link rel="stylesheet" href="~/css/tc-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    <style>
        /* ✅ Saved addresses section */
        .tc-saved-addresses {
            margin-top: 32px;
            padding-top: 28px;
            border-top: 1px solid var(--tc-border);
        }

        .tc-saved-addresses__title {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--tc-gray-3);
            margin-bottom: 16px;
        }

        .tc-saved-addr-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 12px;
        }

        .tc-saved-addr-card {
            background: var(--tc-bg);
            border: 1.5px solid var(--tc-border);
            border-radius: var(--tc-radius-md);
            padding: 14px 16px;
            position: relative;
        }

            .tc-saved-addr-card.default {
                border-color: var(--tc-black);
            }

        .tc-saved-addr-card__badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: var(--tc-black);
            color: #fff;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1px;
            padding: 2px 8px;
            border-radius: 20px;
            text-transform: uppercase;
        }

        .tc-saved-addr-card__name {
            font-size: 13px;
            font-weight: 700;
            color: var(--tc-black);
            margin-bottom: 6px;
        }

        .tc-saved-addr-card__line {
            font-size: 12px;
            color: var(--tc-gray-2);
            line-height: 1.6;
        }

        .tc-saved-addr-card__delete {
            margin-top: 10px;
            font-size: 11px;
            color: var(--tc-danger);
            font-weight: 600;
            background: none;
            border: none;
            cursor: pointer;
            font-family: var(--tc-font-body);
            padding: 0;
            text-decoration: underline;
        }
    </style>
}

<div class="tc-container">
    <div class="tc-profile">

        <div class="tc-profile__header">
            <div class="tc-profile__avatar">
                @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
            </div>
            <div class="tc-profile__header-text">
                <h2>My Profile</h2>
                <p>Manage your personal details</p>
            </div>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProfileId" />

            <div class="tc-form-group">
                <label>Full Name</label>
                <input asp-for="FullName" class="form-control" />
            </div>

            <div class="tc-form-group">
                <label>Email</label>
                <div class="tc-email-row">
                    <input asp-for="Email" class="form-control" readonly />
                    @if (Model.IsEmailConfirmed)
                    {
                        <span class="tc-email-verified">✓ Verified</span>
                    }
                    else
                    {
                        <button type="button"
                                class="tc-btn tc-btn--outline tc-btn--sm"
                                onclick="sendVerificationEmail()">
                            Verify
                        </button>
                    }
                </div>
            </div>

            <div class="tc-form-group">
                <label>Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>

            <div class="tc-form-group">
                <label>Address</label>
                <input asp-for="Address" class="form-control" placeholder="Street, Area, House No." />
            </div>

            <div class="tc-two-col">
                <div class="tc-form-group">
                    <label>City</label>
                    <input asp-for="City" class="form-control" />
                </div>
                <div class="tc-form-group">
                    <label>State</label>
                    <input asp-for="State" class="form-control" />
                </div>
            </div>

            <div class="tc-form-group">
                <label>Postal Code</label>
                <input asp-for="PostalCode" class="form-control" />
            </div>

            <div class="tc-profile__actions">
                <button type="submit" class="tc-btn tc-btn--primary">
                    Save Changes
                </button>
                <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword"
                   style="display:inline-block;margin-top:12px;font-size:13px;color:var(--tc-gray-2);text-decoration:underline;">
                    Change Password →
                </a>
                <button type="button"
                        class="tc-btn tc-btn--outline"
                        onclick="logoutUser()"
                        style="border-color:#e5e7eb; color:var(--tc-danger);">
                    Logout
                </button>
            </div>
        </form>

        @* ✅ Show all saved addresses *@
        @if (Model.SavedAddresses != null && Model.SavedAddresses.Any())
        {
            <div class="tc-saved-addresses">
                <div class="tc-saved-addresses__title">Saved Addresses (@Model.SavedAddresses.Count())</div>
                <div class="tc-saved-addr-grid">
                    @foreach (var addr in Model.SavedAddresses)
                    {
                        <div class="tc-saved-addr-card @(addr.IsDefault ? "default" : "")">
                            @if (addr.IsDefault)
                            {
                                <span class="tc-saved-addr-card__badge">Default</span>
                            }
                            <div class="tc-saved-addr-card__name">@addr.Name</div>
                            @if (!string.IsNullOrEmpty(addr.PhoneNumber))
                            {
                                <div class="tc-saved-addr-card__line">📞 @addr.PhoneNumber</div>
                            }
                            <div class="tc-saved-addr-card__line">
                                @addr.Street<br />
                                @addr.City, @addr.State<br />
                                @addr.PostalCode
                            </div>

                            @* Delete button *@
                            <form asp-area="Customer"
                                  asp-controller="Address"
                                  asp-action="Delete"
                                  asp-route-id="@addr.Id"
                                  method="post"
                                  onsubmit="return confirm('Delete this address?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="tc-saved-addr-card__delete">
                                    Remove
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }

        <form id="verifyEmailForm"
              asp-action="SendVerificationEmail"
              asp-controller="Profile"
              method="post"></form>
        <form id="logoutForm"
              asp-area="Identity"
              asp-page="/Account/Logout"
              method="post"></form>

    </div>
</div>

<script>
    function sendVerificationEmail() { document.getElementById("verifyEmailForm").submit(); }
    function logoutUser() { document.getElementById("logoutForm").submit(); }
</script>
