@model TrendClothing.Models.ViewModels.ProfileVM
<link rel="stylesheet" href="~/css/profile.css" />

<div class="profile-page">

    <!-- PAGE WRAPPER -->
    <div class="profile-wrapper">

        <!-- TOP HEADER -->
        <div class="profile-top">
            <div class="avatar">
                @(string.IsNullOrEmpty(Model.FullName)
                                ? "U"
                                : Model.FullName.Substring(0, 1).ToUpper())
            </div>

            <div>
                <h3>My Profile</h3>
                <p class="text-muted">Manage your personal details</p>
            </div>
        </div>

        <!-- PROFILE FORM -->
        <form method="post" class="profile-form">

            <input type="hidden" asp-for="ProfileId" />

            <div class="form-group">
                <label>Full Name</label>
                <input asp-for="FullName" class="form-control" />
            </div>

            <!-- EMAIL -->
            <div class="form-group">
                <label>Email</label>

                <div class="email-row">
                    <input asp-for="Email" class="form-control" readonly />

                    @if (Model.IsEmailConfirmed)
                    {
                        <span class="email-verified">Verified ✓</span>
                    }
                    else
                    {
                        <button type="button"
                                class="btn-verify"
                                onclick="sendVerificationEmail()">
                            Verify Email
                        </button>
                    }
                </div>
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>

            <div class="form-group">
                <label>Address</label>
                <input asp-for="Address" class="form-control" />
            </div>

            <div class="form-group two-col">
                <div>
                    <label>City</label>
                    <input asp-for="City" class="form-control" />
                </div>
                <div>
                    <label>State</label>
                    <input asp-for="State" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label>Postal Code</label>
                <input asp-for="PostalCode" class="form-control" />
            </div>

            <!-- ACTIONS -->
            <div class="profile-actions">
                <button type="submit" class="btn-save">
                    Save Changes
                </button>

                <button type="button"
                        class="btn-logout"
                        onclick="logoutUser()">
                    Logout
                </button>
            </div>

        </form>

        <!-- HIDDEN FORMS (OUTSIDE MAIN FORM) -->
        <form id="verifyEmailForm"
              asp-action="SendVerificationEmail"
              asp-controller="Profile"
              method="post">
        </form>

        <form id="logoutForm"
              asp-area="Identity"
              asp-page="/Account/Logout"
              method="post">
        </form>

    </div>
</div>

<script>
    function sendVerificationEmail() {
        document.getElementById("verifyEmailForm").submit();
    }

    function logoutUser() {
        document.getElementById("logoutForm").submit();
    }
</script>
