@model TrendClothing.Models.ViewModels.ProfileVM
<link rel="stylesheet" href="~/css/profile.css" />

<div class="profile-page">

    <div class="profile-top">
        <div class="avatar">
            @(string.IsNullOrEmpty(Model.FullName)
                        ? "U"
                        : Model.FullName.Substring(0, 1).ToUpper())
        </div>
        <div>
            <h3>My Profile</h3>
            <p class="text-muted">Manage your personal details</p>
        </div>
    </div>

    <form method="post" class="profile-card">

        <input type="hidden" asp-for="ProfileId" />

        <div class="mb-3">
            <label>Full Name</label>
            <input asp-for="FullName" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Phone Number</label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Address</label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="mb-3">
            <label>City</label>
            <input asp-for="City" class="form-control" />
        </div>

        <div class="mb-3">
            <label>State</label>
            <input asp-for="State" class="form-control" />
        </div>

        <div class="mb-4">
            <label>Postal Code</label>
            <input asp-for="PostalCode" class="form-control" />
        </div>

        <button class="btn btn-primary px-4">
            Save Changes
        </button>
    </form>
</div>
