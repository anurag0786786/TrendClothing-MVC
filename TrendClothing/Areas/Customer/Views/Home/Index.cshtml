@* ══════════════════════════════════════
   3. NEW ARRIVALS
══════════════════════════════════════ *@
@{
    var homeReviews = ViewBag.HomeReviews as Dictionary<int, double> ?? new Dictionary<int, double>();
    var homeWishlist = ViewBag.HomeWishlist as HashSet<int> ?? new HashSet<int>();
}
@Html.AntiForgeryToken()
@if (Model != null && Model.Any())
{
    <section class="tc-section-gap tc-container" id="new-arrivals">
        <div class="tc-section-head">
            <div>
                <p class="tc-section-head__sub">Catalogs</p>
                <h2 class="tc-section-head__title">Fresh arrivals and<br />new selections.</h2>
            </div>
            <a asp-action="Category" asp-route-name="Topwear" class="tc-section-head__link">View all →</a>
        </div>

        <div class="tc-home-product-grid">
            @foreach (var product in Model)
            {
                homeReviews.TryGetValue(product.Id, out double homeAvg);
                bool homeIsWl = homeWishlist.Contains(product.Id);
                <div class="tc-product-card">
                    <div class="tc-product-card__img-wrap">
                        <a asp-action="Details" asp-route-id="@product.Id" style="display:block;height:100%;">
                            <img src="@product.ImageUrl" alt="@product.Name" class="tc-product-card__img" loading="lazy" />
                        </a>
                        @if (product.DiscountPrice > 0 && product.DiscountPrice < product.Price)
                        {
                            var pct = (int)(((product.Price - product.DiscountPrice) / product.Price) * 100);
                            <span class="tc-product-card__badge">@pct% OFF</span>
                        }
                        @if (homeAvg > 0)
                        {
                            <div class="tc-card-rating"><span class="star">★</span> @homeAvg</div>
                        }
                        else
                        {
                            <div class="tc-card-rating no-rating">No rating</div>
                        }
                    </div>
                    <div class="tc-product-card__body">
                        <div class="tc-product-card__brand">@product.Brand?.Name</div>
                        <div class="tc-product-card__name">@product.Name</div>
                        <div class="tc-product-card__price-row">
                            @if (product.DiscountPrice > 0 && product.DiscountPrice < product.Price)
                            {
                                <span class="tc-product-card__price">&#8377; @product.DiscountPrice</span>
                                <span class="tc-product-card__price-old">&#8377; @product.Price</span>
                            }
                            else
                            {
                                <span class="tc-product-card__price">&#8377; @product.Price</span>
                            }
                        </div>
                        <div style="display:flex;gap:8px;align-items:center;">
                            <a asp-action="Details" asp-route-id="@product.Id" class="tc-product-card__cta" style="flex:1;">View Details</a>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <button type="button"
                                        class="tc-card-wl-row-btn @(homeIsWl ? "wishlisted" : "")"
                                        data-pid="@product.Id"
                                        onclick="catWlToggle(this)"
                                        title="@(homeIsWl ? "Remove from wishlist" : "Add to wishlist")">
                                    <svg viewBox="0 0 24 24" width="15" height="15" stroke="#c1440e" fill="@(homeIsWl ? "#c1440e" : "none")" stroke-width="2">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                    </svg>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}


@section Scripts {
    <script>
        var __token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        function catWlToggle(btn) {
            var pid = btn.getAttribute('data-pid');
            btn.disabled = true;
            fetch('/Customer/Wishlist/Toggle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': __token },
                body: 'productId=' + pid
            })
            .then(r => r.json())
            .then(d => {
                btn.disabled = false;
                if (!d.success) return;
                btn.classList.toggle('wishlisted', d.wishlisted);
                var svg = btn.querySelector('svg');
                if (svg) svg.setAttribute('fill', d.wishlisted ? '#c1440e' : 'none');
                var t = document.getElementById('toast');
                if (t) { t.textContent = d.message; t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 3000); }
            })
            .catch(() => btn.disabled = false);
        }
    </script>
}
