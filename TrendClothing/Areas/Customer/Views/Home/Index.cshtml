@model IEnumerable<TrendClothing.Models.Product>

@section Styles {
    <link rel="stylesheet" href="~/css/tc-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <style>

        /* ══════════════════════════════════════
                   SHARED — subcat + collections grid
                ══════════════════════════════════════ */
        .tc-subcat-section {
            padding: 48px 0;
        }

        .tc-subcat-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 24px;
        }

            .tc-subcat-header h2 {
                font-family: var(--tc-font-body);
                font-size: 1.05rem;
                font-weight: 700;
                letter-spacing: 2px;
                text-transform: uppercase;
                color: var(--tc-black);
            }

            .tc-subcat-header a {
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: var(--tc-gray-2);
                text-decoration: underline;
                text-underline-offset: 3px;
            }

        /* 5-col grid for sub categories */
        .tc-subcat-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 14px;
        }

        /* 4-col grid for collections */
        .tc-collections-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
        }

        /* shared card item */
        .tc-subcat-item {
            display: block;
            text-decoration: none;
            color: var(--tc-black);
        }

        .tc-subcat-item__img-wrap {
            aspect-ratio: 3/4;
            overflow: hidden;
            border-radius: 4px;
            background: var(--tc-surface-alt);
            position: relative;
        }

            .tc-subcat-item__img-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

            .tc-subcat-item__img-wrap .tc-subcat-item__overlay-label {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                padding: 32px 12px 12px;
                background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 100%);
                color: #fff;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: 0.5px;
            }

        .tc-subcat-item:hover .tc-subcat-item__img-wrap img {
            transform: scale(1.05);
            opacity: 1;
        }

        .tc-subcat-item__name {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--tc-black);
            margin-top: 10px;
        }

        .tc-subcat-item__cta {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--tc-gray-3);
            margin-top: 4px;
            text-decoration: underline;
            text-underline-offset: 2px;
        }

        /* ══════════════════════════════════════
                   PRODUCT GRID — 5 col, tall cards
                ══════════════════════════════════════ */
        .tc-home-product-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 14px;
        }

            .tc-home-product-grid .tc-product-card__img-wrap {
                aspect-ratio: 3/4 !important;
            }

        /* ── rating badge ── */
        .tc-card-rating {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: rgba(17,17,16,0.75);
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 3px;
        }

            .tc-card-rating .star {
                color: #f59e0b;
            }

            .tc-card-rating.no-rating {
                color: rgba(255,255,255,0.6);
                font-weight: 400;
            }

        .tc-card-wl-row-btn {
            width: 38px;
            height: 38px;
            border-radius: var(--tc-radius-sm);
            border: 1.5px solid var(--tc-border-dark);
            background: var(--tc-surface);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
            transition: background 0.2s;
        }

            .tc-card-wl-row-btn:hover, .tc-card-wl-row-btn.wishlisted {
                background: #fde8e0;
                border-color: #f0a090;
            }

        /* ══════════════════════════════════════
                   RESPONSIVE
                ══════════════════════════════════════ */
        @@media (max-width: 1024px) {
            .tc-home-product-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        @@media (max-width: 900px) {
            .tc-subcat-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .tc-collections-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .tc-home-product-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 600px) {
            .tc-subcat-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .tc-collections-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .tc-home-product-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
}

@* ══════════════════════════════════════
   1. HERO
══════════════════════════════════════ *@
<section class="tc-hero">
    <div class="tc-hero__inner tc-container">
        <div class="tc-hero__text">
            <p class="tc-hero__eyebrow">New Season Drop</p>
            <h1 class="tc-hero__title">We are digital<br />meets fashion.</h1>
            <p class="tc-hero__sub">Explore high-quality pieces crafted for every style.</p>
            <div class="tc-hero__actions">
                <a href="#subcategories" class="tc-btn tc-btn--primary tc-btn--lg">
                    Start shopping
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7v10" /></svg>
                </a>
                <a href="#new-arrivals" class="tc-hero__scroll">New arrivals</a>
            </div>
            <div class="tc-hero__stats">
                <div><div class="tc-hero__stat-num">500+</div><div class="tc-hero__stat-label">Products</div></div>
                <div><div class="tc-hero__stat-num">10K+</div><div class="tc-hero__stat-label">Customers</div></div>
                <div><div class="tc-hero__stat-num">50+</div><div class="tc-hero__stat-label">Brands</div></div>
            </div>
        </div>
        <div class="tc-hero__img-wrap">
            <div class="tc-hero__badge tc-hero__badge--1">
                <div class="tc-hero__badge-icon">✦</div>
                <div><div class="tc-hero__badge-text-main">New Season</div><div class="tc-hero__badge-text-sub">2025 Collection</div></div>
            </div>
            <div class="tc-hero__discount"><strong>50%</strong>OFF</div>
            <div class="tc-hero__badge tc-hero__badge--2">
                <div class="tc-hero__badge-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                </div>
                <div><div class="tc-hero__badge-text-main">Free Delivery</div><div class="tc-hero__badge-text-sub">On all orders</div></div>
            </div>
            <div class="tc-hero__badge tc-hero__badge--3">
                <div class="tc-hero__badge-icon tc-hero__badge-icon--gold">★</div>
                <div><div class="tc-hero__badge-text-main">4.9 Rating</div><div class="tc-hero__badge-text-sub">500+ Reviews</div></div>
            </div>
            <img src="@ViewBag.HeroImg" alt="New Season" class="tc-hero__img" />
            <div class="tc-hero__watermark">TRENDY</div>
        </div>
    </div>
</section>

