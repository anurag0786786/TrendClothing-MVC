@model IEnumerable<TrendClothing.Models.Product>
<link rel="stylesheet" href="~/css/index.mobile.css" />
<div class="desktop-only">

<div class="hero-section">
    <a href="#categories" class="hero-link">
        <div class="hero-wrapper">
            <img src="~/Images/hero/hero.jpg" class="hero-img" />
        </div>
    </a>
</div>

<!-- CHOOSE CATEGORY HEADING -->
<div class="choose-category-wrap">
    <span class="line"></span>
    <h2>Choose Category</h2>
    <span class="line"></span>
</div>

<!-- CATEGORIES -->
<div class="container" id="categories">
    <div class="row text-center">

        <!-- MEN -->
        <div class="col-md-4 mb-4">
            <a asp-action="Category" asp-route-name="Men" class="text-decoration-none text-dark">
                <div class="category-card">
                    <div class="category-img">
                        <img src="~/Images/Categories/Men.jpg" alt="Men" />
                    </div>
                    <div class="category-body">
                        <h4 class="gold-text">Men</h4>
                    </div>
                </div>
            </a>
        </div>

        <!-- WOMEN -->
        <div class="col-md-4 mb-4">
            <a asp-action="Category" asp-route-name="Women" class="text-decoration-none text-dark">
                <div class="category-card">
                    <div class="category-img">
                        <img src="~/Images/Categories/Women.jpg" alt="Women" />
                    </div>
                    <div class="category-body">
                        <h4 class="gold-text">Women</h4>
                    </div>
                </div>
            </a>
        </div>

        <!-- CHILDREN -->
        <div class="col-md-4 mb-4">
            <a asp-action="Category" asp-route-name="Children" class="text-decoration-none text-dark">
                <div class="category-card">
                    <div class="category-img">
                        <img src="~/Images/Categories/Children.jpg" alt="Children" />
                    </div>
                    <div class="category-body">
                        <h4 class="gold-text">Children</h4>
                    </div>
                </div>
            </a>
        </div>
        </div>

    </div>
</div>

<!-- MOBILE HOME -->
<!-- ================= MOBILE HOME ================= -->
<div class="mobile-only">

    <!-- TOP CATEGORY TABS -->
    <div class="m-top-tabs">
        <a asp-action="Index" asp-route-name="Home" class="active">Home</a>
        <a asp-action="Category" asp-route-name="Men">MEN</a>
        <a asp-action="Category" asp-route-name="Women">WOMEN</a>
        <a asp-action="Category" asp-route-name="Children">CHILDREN</a>
    </div>

    <!-- HERO IMAGE -->
    <section class="m-hero-image">
        <a href="#choose-category" class="hero-click">
            <section class="m-hero-image">
                <img src="~/Images/hero1.jpg" alt="New Season" />

                <div class="hero-overlay"></div>

                <div class="hero-text">
                
                    <p>Explore Fresh Arrivals</p>
                </div>
            </section>
        </a>

    </section>
    <div>
        <h3 class="m-choose-title">Choose Category</h3>
    </div>
  
    <!-- CHOOSE CATEGORIES WITH IMAGES -->
    <section id="choose-category" class="m-choose-categories">

        @* <h3 class="m-choose-title">Choose Category</h3> *@

        <div class="m-choose-grid">

            <!-- MEN -->
            <a asp-action="Category"
               asp-route-name="Men"
               class="m-choose-card active">
                <img src="~/Images/Categories/Men.jpg" alt="Men" />
                <span>MEN</span>
            </a>

            <!-- WOMEN -->
            <div class="m-choose-card disabled">
                <img src="~/Images/Categories/Women.jpg" alt="Women" />
                <span>WOMEN</span>
                <small>Coming Soon</small>
            </div>

            <!-- CHILDREN -->
            <div class="m-choose-card disabled">
                <img src="~/Images/Categories/Children.jpg" alt="Children" />
                <span>CHILDREN</span>
                <small>Coming Soon</small>
            </div>

            @* <!-- COMING SOON -->
            <div class="m-choose-card coming">
                <img src="~/Images/Categories/ComingSoon.jpg" alt="Coming Soon" />
                <span>COMING SOON</span>
            </div> *@

        </div>

    </section>


    @* <!-- PROMO IMAGE -->
    <section class="m-promo">
        <img src="~/Images/Categories/Women.jpg" alt="Offer" />
    </section> *@

</div>
