@model TrendClothing.Models.ViewModels.ProductFilterVM

@section Styles {
    <link rel="stylesheet" href="~/css/tc-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/category.css" asp-append-version="true" />
}

<div class="tc-cat-page tc-container">

    @* BREADCRUMB *@
    <nav class="tc-breadcrumb">
        <a href="/">Home</a>
        <span class="tc-breadcrumb__sep">/</span>
        <span class="tc-breadcrumb__current">@ViewBag.CategoryName</span>
    </nav>

    @* PAGE HEADER *@
    <div class="tc-cat-page__header">
        <div>
            <h1 class="tc-cat-page__title">@ViewBag.CategoryName Wear</h1>
            <p class="tc-cat-page__count">
                @(Model.Products?.Count() ?? 0) products
            </p>
        </div>

        @* FILTERS ROW *@
        <div class="tc-cat-page__filters">
            <form method="get" class="tc-filter-form">
                <input type="hidden" name="name" value="@ViewBag.CategoryName" />

                @* PRODUCT TYPE FILTER *@
                <select name="Search"
                        class="tc-nav__select"
                        onchange="this.form.submit()">
                    <option value="">All Products</option>
                    @foreach (var type in ViewBag.ProductTypes as List<string>)
                    {
                        <option value="@type" selected="@(Model.Search == type)">@type</option>
                    }
                </select>

                @* SORT *@
                <select name="Sort"
                        class="tc-nav__select"
                        onchange="this.form.submit()">
                    <option value="">New Product</option>
                    <option value="low"  selected="@(Model.Sort == "low")">Price: Low to High</option>
                    <option value="high" selected="@(Model.Sort == "high")">Price: High to Low</option>
                </select>

                @* SEARCH *@
                <div class="tc-nav__search">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    <input type="text"
                           name="Search"
                           value="@Model.Search"
                           placeholder="Search products..." />
                </div>
            </form>

            @* CATEGORY TABS *@
            <div class="tc-cat-tabs">
                <a asp-action="Category" asp-route-name="Men"
                   class="tc-nav__cat-btn @(ViewBag.CategoryName == "Men" ? "active" : "")">Men</a>
                <a asp-action="Category" asp-route-name="Women"
                   class="tc-nav__cat-btn @(ViewBag.CategoryName == "Women" ? "active" : "")">Women</a>
                <a asp-action="Category" asp-route-name="Children"
                   class="tc-nav__cat-btn @(ViewBag.CategoryName == "Children" ? "active" : "")">Children</a>
            </div>
        </div>
    </div>

    <hr class="tc-divider" />

    @* PRODUCT GRID *@
    @if (Model.Products != null && Model.Products.Any())
    {
        <div class="tc-grid-4 tc-cat-page__grid">
            @foreach (var product in Model.Products)
            {
                <div class="tc-product-card">
                    <div class="tc-product-card__img-wrap">
                        <img src="@product.ImageUrl" alt="@product.Name" class="tc-product-card__img" />
                        @if (product.DiscountPrice > 0 && product.DiscountPrice < product.Price)
                        {
                            var pct = (int)(((product.Price - product.DiscountPrice) / product.Price) * 100);
                            <span class="tc-product-card__badge">@pct% OFF</span>
                        }
                        <a asp-action="Details" asp-route-id="@product.Id" class="tc-product-card__action">+</a>
                    </div>
                    <div class="tc-product-card__body">
                        <div class="tc-product-card__brand">@product.Brand?.Name</div>
                        <div class="tc-product-card__name">@product.Name</div>
                        <div class="tc-product-card__price-row">
                            @if (product.DiscountPrice > 0 && product.DiscountPrice < product.Price)
                            {
                                <span class="tc-product-card__price">&#8377; @product.DiscountPrice</span>
                                <span class="tc-product-card__price-old">&#8377; @product.Price</span>
                            }
                            else
                            {
                                <span class="tc-product-card__price">&#8377; @product.Price</span>
                            }
                        </div>
                        <a asp-action="Details" asp-route-id="@product.Id" class="tc-product-card__cta">
                            View Details
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="tc-empty">
            <div class="tc-empty__icon">🔍</div>
            <div class="tc-empty__title">No products found</div>
            <div class="tc-empty__sub">Try changing your filters or search term</div>
        </div>
    }

</div>

@* MOBILE BOTTOM FILTER BAR *@
<div class="tc-mobile-filter-bar">
    <form method="get" class="tc-mobile-filter-form">
        <input type="hidden" name="name" value="@ViewBag.CategoryName" />
        <select name="Search" onchange="this.form.submit()" class="tc-mobile-filter-select">
            <option value="">All Types</option>
            @foreach (var type in ViewBag.ProductTypes as List<string>)
            {
                <option value="@type" selected="@(Model.Search == type)">@type</option>
            }
        </select>
    </form>
    <form method="get" class="tc-mobile-filter-form">
        <input type="hidden" name="name" value="@ViewBag.CategoryName" />
        <select name="Sort" onchange="this.form.submit()" class="tc-mobile-filter-select">
            <option value="">New Product</option>
            <option value="low"  selected="@(Model.Sort == "low")">Price ↑</option>
            <option value="high" selected="@(Model.Sort == "high")">Price ↓</option>
        </select>
    </form>
</div>
