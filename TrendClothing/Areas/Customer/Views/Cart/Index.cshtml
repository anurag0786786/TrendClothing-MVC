@model TrendClothing.Models.ViewModels.ShoppingCartVM

@{
    ViewData["Title"] = "My Cart";
    double bagTotal = 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tc-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
}

<div class="tc-container tc-cart-page">

    <h1 class="tc-cart-page__title">
        My Bag
        <span style="font-size:1rem; font-weight:500; color:var(--tc-gray-3); font-family:var(--tc-font-body);">
            (@(Model.ListCart?.Count() ?? 0) items)
        </span>
    </h1>

    @if (Model.ListCart != null && Model.ListCart.Any())
    {
        <div class="row g-4">
            @* LEFT — ITEMS *@
            <div class="col-md-8">
                @foreach (var item in Model.ListCart)
                {
                    var price = (item.ProductVariant.Product.DiscountPrice > 0
                    ? item.ProductVariant.Product.DiscountPrice
                    : item.ProductVariant.Product.Price) ?? 0;
                    var subTotal = price * item.Count;
                    bagTotal += subTotal;

                    <div class="tc-cart-item">
                        <img src="@(item.ProductVariant.Product.ImageUrl ?? "/images/no-image.png")"
                             alt="product"
                             class="tc-cart-item__img" />

                        <div class="tc-cart-item__body">
                            <div class="tc-cart-item__name">@item.ProductVariant.Product.Name</div>
                            <div class="tc-cart-item__meta">
                                Size: @item.ProductVariant.Size.Name &nbsp;·&nbsp;
                                Color: @item.ProductVariant.Color.Name
                            </div>
                            <div class="tc-cart-item__price">&#8377; @price</div>

                            <div class="tc-qty-row">
                                <a asp-action="Minus" asp-route-id="@item.Id">−</a>
                                <span class="tc-qty-row__count">@item.Count</span>
                                <a asp-action="Plus" asp-route-id="@item.Id">+</a>
                            </div>
                        </div>

                        <a asp-action="Remove" asp-route-id="@item.Id" class="tc-cart-item__delete">
                            Remove
                        </a>
                    </div>
                }
            </div>

            @* RIGHT — SUMMARY *@
            <div class="col-md-4">
                <div class="tc-order-summary">
                    <div class="tc-order-summary__title">Order Summary</div>

                    <div class="tc-order-summary__row">
                        <span>Subtotal</span>
                        <span>&#8377; @bagTotal</span>
                    </div>
                    <div class="tc-order-summary__row">
                        <span>Delivery</span>
                        <span style="color:var(--tc-success); font-weight:600;">Free</span>
                    </div>

                    <div class="tc-order-summary__row tc-order-summary__row--total">
                        <span>Total</span>
                        <span>&#8377; @bagTotal</span>
                    </div>

                    <div class="tc-order-summary__cta">
                        @if (ViewBag.IsEmailConfirmed == true)
                        {
                            <a asp-action="Summary" class="tc-btn tc-btn--primary tc-btn--full">
                                Proceed to Shipping →
                            </a>
                        }
                        else
                        {
                            <div style="font-size:13px; color:var(--tc-warn); background:#fef9e7; border:1px solid #fde68a; border-radius:var(--tc-radius-md); padding:12px; margin-bottom:8px;">
                                ⚠ Please verify your email to continue checkout
                            </div>
                            <button type="button"
                                    class="tc-btn tc-btn--outline tc-btn--full"
                                    onclick="sendVerificationEmail()">
                                Verify Email
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="tc-empty">
            <div class="tc-empty__icon">🛍</div>
            <div class="tc-empty__title">Your bag is empty</div>
            <div class="tc-empty__sub">Add some items to get started</div>
            <a asp-action="Index" asp-controller="Home" class="tc-btn tc-btn--primary tc-mt-md">
                Continue Shopping
            </a>
        </div>
    }
</div>

<form id="verifyEmailForm"
      asp-action="SendVerificationEmail"
      asp-controller="Profile"
      method="post"></form>

<script>
    function sendVerificationEmail() {
        document.getElementById("verifyEmailForm").submit();
    }
</script>
