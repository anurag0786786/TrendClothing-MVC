@using TrendClothing.Models.ViewModels
@model CheckoutVM

@{
    ViewData["Title"] = "Select Address";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tc-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
}

<div class="tc-container">
    <div class="tc-checkout">

        <nav class="tc-breadcrumb">
            <a href="/">Home</a>
            <span class="tc-breadcrumb__sep">/</span>
            <a asp-area="Customer" asp-controller="Cart" asp-action="Index">My Bag</a>
            <span class="tc-breadcrumb__sep">/</span>
            <span class="tc-breadcrumb__current">Select Address</span>
        </nav>

        <h1 class="tc-checkout__title">Select Delivery Address</h1>

        @* ✅ FIX: AntiForgeryToken add kiya Payment form mein *@
        <form asp-area="Customer"
              asp-controller="Cart"
              asp-action="Payment"
              method="post"
              id="paymentForm"
              onsubmit="return validateAddress()">

            @Html.AntiForgeryToken()

            <div class="tc-address-grid" id="addressGrid">
                @foreach (var address in Model.Addresses)
                {
                    <label class="tc-address-card" style="position:relative;">
                        <input type="radio"
                               name="SelectedAddressId"
                               value="@address.Id"
                               class="address-radio" />
                        <div class="tc-address-box">
                            <strong>@address.Name</strong>
                            @if (!string.IsNullOrEmpty(address.PhoneNumber))
                            {
                                <p style="color:var(--tc-gray-3);font-size:12px;">📞 @address.PhoneNumber</p>
                            }
                            <p>@address.Street</p>
                            <p>@address.City, @address.State</p>
                            <p>@address.PostalCode</p>
                        </div>
                    </label>
                    @* ✅ FIX: No nested form — AJAX delete *@
                    <button type="button"
                            onclick="deleteAddress(@address.Id, this)"
                            style="position:absolute;top:8px;right:8px;z-index:5;width:22px;height:22px;border-radius:50%;border:1px solid var(--tc-border-dark);background:white;font-size:11px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#c1440e;font-weight:700;line-height:1;">
                        ✕
                    </button>
                }

                <!-- ADD NEW ADDRESS -->
                <div class="tc-address-add"
                     data-bs-toggle="modal"
                     data-bs-target="#addAddressModal"
                     style="cursor:pointer;">
                    <span class="tc-address-add__icon">+</span>
                    <span>Add New Address</span>
                </div>
            </div>

            @* ✅ Address not selected warning *@
            <div id="addressError"
                 style="display:none;color:#c1440e;font-size:13px;font-weight:600;margin-bottom:12px;">
                ⚠️ Please select a delivery address first
            </div>

            @* ── COUPON SECTION ── *@
            <div style="margin-bottom:20px;padding:16px;background:var(--tc-surface);border:1px solid var(--tc-border);border-radius:var(--tc-radius-md);">
                <div style="font-size:13px;font-weight:600;color:var(--tc-black);margin-bottom:10px;">Have a coupon code?</div>

                @* Order summary *@
                <div style="font-size:13px;color:var(--tc-gray-2);margin-bottom:12px;">
                    Subtotal: <strong id="subtotalAmt">&#8377; @Model.Cart.OrderHeader.OrderTotal.ToString("N0")</strong>
                </div>

                <div style="display:flex;gap:8px;align-items:center;">
                    <input type="text" id="couponInput"
                           placeholder="Enter code e.g. SAVE20"
                           style="flex:1;padding:9px 14px;border:1.5px solid var(--tc-border-dark);border-radius:var(--tc-radius-sm);font-family:var(--tc-font-body);font-size:13px;text-transform:uppercase;outline:none;" />
                    <button type="button" onclick="applyCoupon()"
                            style="padding:9px 18px;background:var(--tc-black);color:#fff;border:none;border-radius:var(--tc-radius-sm);font-size:13px;font-weight:600;cursor:pointer;font-family:var(--tc-font-body);white-space:nowrap;">
                        Apply
                    </button>
                    <button type="button" id="removeCouponBtn" onclick="removeCoupon()"
                            style="display:none;padding:9px 14px;background:#fde8e0;color:#c1440e;border:1px solid #f0a090;border-radius:var(--tc-radius-sm);font-size:13px;font-weight:600;cursor:pointer;font-family:var(--tc-font-body);">
                        Remove
                    </button>
                </div>

                <div id="couponMsg" style="font-size:12px;margin-top:8px;font-weight:600;"></div>

                <div id="discountRow" style="display:none;margin-top:10px;padding-top:10px;border-top:1px solid var(--tc-border);">
                    <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--tc-gray-2);">
                        <span>Subtotal</span><span id="origTotal"></span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:13px;color:#2d6a4f;font-weight:600;margin-top:4px;">
                        <span>Discount</span><span id="discountAmt"></span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:15px;font-weight:700;color:var(--tc-black);margin-top:8px;">
                        <span>Total</span><span id="finalTotalAmt"></span>
                    </div>
                </div>
            </div>

            <button type="submit" class="tc-btn tc-btn--primary tc-btn--lg">
                Proceed to Payment
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
            </button>
        </form>
    </div>
</div>

<!-- ===================== ADD ADDRESS MODAL ===================== -->
<div class="modal fade" id="addAddressModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" style="font-family:var(--tc-font-display); font-weight:400;">Add New Address</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                @* ✅ FIX: AntiForgeryToken in address form *@
                <form asp-area="Customer"
                      asp-controller="Address"
                      asp-action="Create"
                      method="post"
                      id="addAddressForm">

                    @Html.AntiForgeryToken()

                    <div class="tc-form-group">
                        <label>Full Name</label>
                        <input name="Name" class="form-control" placeholder="Enter full name" required />
                    </div>
                    <div class="tc-form-group">
                        <label>Phone Number</label>
                        <input name="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                    </div>
                    <div class="tc-form-group">
                        <label>Street Address</label>
                        <input name="Street" class="form-control" placeholder="Street, Area, House No." required />
                    </div>
                    <div class="tc-two-col">
                        <div class="tc-form-group">
                            <label>City</label>
                            <input name="City" class="form-control" placeholder="City" required />
                        </div>
                        <div class="tc-form-group">
                            <label>State</label>
                            <input name="State" class="form-control" placeholder="State" required />
                        </div>
                    </div>
                    <div class="tc-form-group">
                        <label>Postal Code</label>
                        <input name="PostalCode" class="form-control" placeholder="PIN Code" required />
                    </div>
                    <button type="submit" class="tc-btn tc-btn--primary tc-btn--full">
                        Save Address
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>

<script>
    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    var orderTotal = @Model.Cart.OrderHeader.OrderTotal;
    var appliedDiscount = 0;

    // ✅ Validate address selected before payment
    function validateAddress() {
        var selected = document.querySelector('input[name="SelectedAddressId"]:checked');
        if (!selected) {
            document.getElementById('addressError').style.display = 'block';
            return false;
        }
        document.getElementById('addressError').style.display = 'none';
        return true;
    }

    document.querySelectorAll('.address-radio').forEach(function(radio) {
        radio.addEventListener('change', function() {
            document.getElementById('addressError').style.display = 'none';
        });
    });

    // ── COUPON APPLY ──
    function applyCoupon() {
        var code = document.getElementById('couponInput').value.trim();
        if (!code) return;

        fetch('/Customer/Coupon/Validate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: 'code=' + encodeURIComponent(code) + '&orderTotal=' + orderTotal
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            var msg = document.getElementById('couponMsg');
            if (!d.success) {
                msg.textContent = d.message;
                msg.style.color = '#c1440e';
                showToast(d.message || 'Invalid coupon code', 'error');
                return;
            }
            appliedDiscount = d.discount;
            msg.textContent = d.message;
            msg.style.color = '#2d6a4f';
            showToast('🎉 Coupon applied! You saved ₹' + d.discount.toFixed(0), 'success');

            // Show discount breakdown
            document.getElementById('discountRow').style.display = 'block';
            document.getElementById('origTotal').textContent     = '₹' + orderTotal.toFixed(0);
            document.getElementById('discountAmt').textContent   = '- ₹' + d.discount.toFixed(0);
            document.getElementById('finalTotalAmt').textContent = '₹' + d.finalTotal.toFixed(0);

            // Show remove button, hide apply
            document.getElementById('removeCouponBtn').style.display = 'inline-block';
            document.getElementById('couponInput').disabled = true;
        });
    }

    // ── COUPON REMOVE ──
    function removeCoupon() {
        fetch('/Customer/Coupon/Remove', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: ''
        })
        .then(function() {
            appliedDiscount = 0;
            document.getElementById('couponInput').value    = '';
            document.getElementById('couponInput').disabled = false;
            document.getElementById('couponMsg').textContent = '';
            document.getElementById('discountRow').style.display = 'none';
            document.getElementById('removeCouponBtn').style.display = 'none';
            showToast('Coupon removed', 'info');
        });
    }

    // Allow Enter key on coupon input
    document.getElementById('couponInput')?.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); applyCoupon(); }
    });

    // ── DELETE ADDRESS — AJAX ──
    function deleteAddress(id, btn) {
        if (!confirm('Remove this address?')) return;
        btn.disabled = true;
        fetch('/Customer/Address/Delete', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'id=' + id
        })
        .then(function(r) {
            // Address card remove karo
            var card = btn.closest('label');
            if (card) {
                card.style.transition = 'opacity 0.3s';
                card.style.opacity = '0';
                setTimeout(function() {
                    card.remove();
                    btn.remove();
                }, 300);
            } else {
                window.location.reload();
            }
        })
        .catch(function() { btn.disabled = false; });
    }
</script>
