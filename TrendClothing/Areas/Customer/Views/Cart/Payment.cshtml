@using Microsoft.AspNetCore.Http
<link rel="stylesheet" href="~/css/payment.css" />

<div class="payment-wrapper">
    <h3>Select Payment Method</h3>
    <p class="text-muted">More payment options coming soon 🚀</p>

    <div class="payment-options">

        <!-- ✅ STRIPE -->
        <form asp-area="Customer"
              asp-controller="Stripe"
              asp-action="Pay"
              method="post">

            <input type="hidden"
                   name="SelectedAddressId"
                   value="@Context.Session.GetInt32("SelectedAddressId")" />

            <button type="submit" class="payment-card active">
                💳 Credit / Debit Card
                <span class="badge bg-success ms-2">Available</span>
            </button>
        </form>

        <!-- 🚧 COMING SOON -->
        <button class="payment-card disabled" disabled>
            📱 UPI
            <span class="coming-soon">Coming Soon</span>
        </button>

        <button class="payment-card disabled" disabled>
            🚚 Cash on Delivery
            <span class="coming-soon">Coming Soon</span>
        </button>

    </div>
</div>
