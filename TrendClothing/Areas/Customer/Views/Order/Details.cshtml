@model IEnumerable<TrendClothing.Models.OrderDetails>

@{
    var order = ViewBag.OrderHeader;
    ViewData["Title"] = "Order Details";
}

<link rel="stylesheet" href="~/css/order-details.css" />

<div class="container my-5">

    <!-- ================= ORDER SUMMARY ================= -->
    <div class="order-summary mb-4">
        <div class="row">
            <div class="col-md-8">
                <h4>Order #@order.Id</h4>
                <p class="text-muted mb-1">
                    Placed on @order.OrderDate.ToString("dd MMM yyyy")
                </p>
                <span class="badge bg-success">@order.OrderStatus</span>
            </div>

            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <h5>Total Amount</h5>
                <h4 class="text-success">₹ @order.OrderTotal</h4>
            </div>
        </div>

        <hr />

        <p class="mb-1"><strong>Delivery Address</strong></p>
        <p class="text-muted mb-0">
            @order.Name<br />
            @order.StreetAddress, @order.City<br />
            @order.State - @order.PostalCode
        </p>
    </div>

    <!-- ================= ORDER ITEMS ================= -->
    <h5 class="mb-3">Items in your order</h5>

    @foreach (var item in Model)
    {
        <div class="order-item card mb-3 shadow-sm">
            <div class="row g-0 align-items-center">

                <!-- Product Image -->
                <div class="col-md-3 text-center p-2">
                    <img src="@item.Product.ImageUrl"
                         class="img-fluid rounded order-img"
                         alt="@item.Product.Name" />
                </div>

                <!-- Product Info -->
                <div class="col-md-6 p-3">
                    <h6 class="fw-bold mb-1">@item.Product.Name</h6>
                    <p class="text-muted mb-1">
                        Quantity: <strong>@item.Count</strong>
                    </p>
                    <p class="text-muted mb-0">
                        Price: ₹ @item.Price
                    </p>
                  
                </div>

                <!-- Price -->
                <div class="col-md-3 text-md-end p-3">
                    <h6 class="fw-bold">
                        ₹ @(item.Price* item.Count)
                    </h6>
                </div>
            </div>
        </div>
    }

    <!-- ================= ACTIONS ================= -->
    <div class="text-center mt-4">
        <a asp-action="Index"
           class="btn btn-outline-secondary px-4">
            Back to My Orders
        </a>
    </div>

</div>
