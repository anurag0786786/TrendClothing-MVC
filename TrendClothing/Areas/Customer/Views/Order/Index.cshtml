@model IEnumerable<TrendClothing.Models.OrderHeader>

@section Styles {
    <link rel="stylesheet" href="~/css/tc-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
}

<div class="tc-container tc-orders-page">

    <h1 class="tc-orders-page__title">My Orders</h1>

    @if (!Model.Any())
    {
        <div class="tc-empty">
            <div class="tc-empty__icon">📦</div>
            <div class="tc-empty__title">No orders yet</div>
            <div class="tc-empty__sub">Start shopping to see your orders here</div>
            <a asp-action="Index" asp-controller="Home" class="tc-btn tc-btn--primary tc-mt-md">
                Start Shopping
            </a>
        </div>
    }
    else
    {
        @* Header Row *@
        <div style="display:grid; grid-template-columns:1fr auto auto auto auto auto; gap:16px; padding:0 24px 12px; font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--tc-gray-3);">
            <span>Order</span>
            <span>Date</span>
            <span>Total</span>
            <span>Payment</span>
            <span>Status</span>
            <span></span>
        </div>

        @foreach (var order in Model)
        {
            <div class="tc-order-row">
                <div class="tc-order-row__id">#@order.Id</div>
                <div class="tc-order-row__date">@order.OrderDate.ToString("dd MMM yyyy")</div>
                <div class="tc-order-row__total">&#8377; @order.OrderTotal</div>
                <div>
                    <span class="tc-badge tc-badge--cream">@order.PaymentStatus</span>
                </div>
                <div>
                    <span class="tc-badge tc-badge--dark">@order.OrderStatus</span>
                </div>
                <div>
                    <a asp-action="Details" asp-route-id="@order.Id"
                       class="tc-btn tc-btn--outline tc-btn--sm">
                        View →
                    </a>
                </div>
            </div>
        }
    }
</div>
