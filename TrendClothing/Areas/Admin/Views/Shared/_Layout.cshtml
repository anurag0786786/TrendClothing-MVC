@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin · TrendClothing</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tc-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.16/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    @RenderSection("Styles", required: false)

    <style>
        .tc-admin-shell {
            display: flex;
            min-height: 100vh;
            background: var(--tc-bg);
        }

        /* SIDEBAR */
        .tc-sidebar {
            width: 240px;
            flex-shrink: 0;
            background: var(--tc-black);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            overflow-y: auto;
            z-index: 300;
            transition: transform 0.3s ease;
        }

        .tc-sidebar__brand {
            padding: 24px 24px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .tc-sidebar__brand-name {
            font-family: var(--tc-font-display);
            font-size: 1.3rem;
            color: #fff;
            text-decoration: none;
            display: block;
        }

        .tc-sidebar__brand-tag {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            margin-top: 2px;
        }

        .tc-sidebar__nav {
            padding: 16px 0;
            flex: 1;
        }

        .tc-sidebar__section-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.25);
            padding: 16px 24px 6px;
        }

        .tc-sidebar__link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 24px;
            font-size: 13px;
            font-weight: 500;
            color: rgba(255,255,255,0.55);
            text-decoration: none;
            transition: all 0.2s;
            border-left: 3px solid transparent;
        }

            .tc-sidebar__link:hover {
                color: #fff;
                background: rgba(255,255,255,0.05);
                opacity: 1;
            }

            .tc-sidebar__link.active {
                color: #fff;
                background: rgba(255,255,255,0.08);
                border-left-color: #fff;
            }

        .tc-sidebar__footer {
            padding: 16px 24px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

            .tc-sidebar__footer a, .tc-sidebar__footer button {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 13px;
                font-weight: 500;
                color: rgba(255,255,255,0.4);
                text-decoration: none;
                background: none;
                border: none;
                cursor: pointer;
                font-family: var(--tc-font-body);
                padding: 8px 0;
                transition: color 0.2s;
                width: 100%;
            }

                .tc-sidebar__footer a:hover, .tc-sidebar__footer button:hover {
                    color: #fff;
                    opacity: 1;
                }

        /* MAIN */
        .tc-admin-main {
            margin-left: 240px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* TOPBAR */
        .tc-admin-topbar {
            background: var(--tc-surface);
            border-bottom: 1px solid var(--tc-border);
            padding: 14px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .tc-admin-topbar__page {
            font-size: 14px;
            font-weight: 600;
            color: var(--tc-black);
        }

        .tc-admin-topbar__right {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .tc-admin-topbar__store-link {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 600;
            color: var(--tc-gray-2);
            text-decoration: none;
            padding: 6px 14px;
            border: 1.5px solid var(--tc-border);
            border-radius: 20px;
            transition: all 0.2s;
        }

            .tc-admin-topbar__store-link:hover {
                border-color: var(--tc-black);
                color: var(--tc-black);
                opacity: 1;
            }

        .tc-admin-topbar__avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--tc-black);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            flex-shrink: 0;
        }

        /* CONTENT */
        .tc-admin-content {
            flex: 1;
            padding: 36px 32px 80px;
        }

        /* Mobile */
        .tc-sidebar-toggle {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            flex-direction: column;
            gap: 5px;
        }

            .tc-sidebar-toggle span {
                display: block;
                width: 20px;
                height: 2px;
                background: var(--tc-black);
                border-radius: 2px;
            }

        .tc-sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 299;
        }

        @@media (max-width:900px) {
            .tc-sidebar {
                transform: translateX(-100%);
            }

                .tc-sidebar.open {
                    transform: translateX(0);
                }

            .tc-admin-main {
                margin-left: 0;
            }

            .tc-admin-topbar {
                padding: 12px 16px;
            }

            .tc-admin-content {
                padding: 24px 16px 60px;
            }

            .tc-sidebar-toggle {
                display: flex;
            }
        }
    </style>
</head>
<body>

    <div class="tc-admin-shell">

        <!-- SIDEBAR -->
        <aside class="tc-sidebar" id="adminSidebar">
            <div class="tc-sidebar__brand">
                <a href="/" class="tc-sidebar__brand-name">TrendClothing</a>
                <div class="tc-sidebar__brand-tag">Admin Panel</div>
            </div>

            <nav class="tc-sidebar__nav">
                <div class="tc-sidebar__section-label">Overview</div>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Dashboard
                </a>
                <a asp-area="Admin" asp-controller="Order" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 01-8 0" /></svg>
                    Orders
                </a>
                <div class="tc-sidebar__section-label">Catalogue</div>

                <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="7" height="7" /><rect x="15" y="3" width="7" height="7" /><rect x="15" y="15" width="7" height="7" /><rect x="2" y="15" width="7" height="7" /></svg>
                    Products
                </a>
                <a asp-area="Admin" asp-controller="ProductVariant" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProductVariant" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14" /></svg>
                    Variants
                </a>
                <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h8M4 18h8" /></svg>
                    Categories
                </a>
                <a asp-area="Admin" asp-controller="ProductType" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProductType" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                    Product Types
                </a>
                <a asp-area="Admin" asp-controller="Brand" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Brand" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6" /><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11" /></svg>
                    Brands
                </a>

                <div class="tc-sidebar__section-label">Inventory</div>

                <a asp-area="Admin" asp-controller="Size" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Size" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 3H3v7h18V3zM21 14H3v7h18v-7z" /></svg>
                    Sizes
                </a>
                <a asp-area="Admin" asp-controller="Color" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Color" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="13.5" cy="6.5" r="2.5" /><circle cx="17.5" cy="10.5" r="2.5" /><circle cx="8.5" cy="7.5" r="2.5" /><circle cx="6.5" cy="12.5" r="2.5" /><path d="M12 22c4.97 0 9-2.24 9-5s-4.03-5-9-5-9 2.24-9 5 4.03 5 9 5z" /></svg>
                    Colors
                </a>

                <div class="tc-sidebar__section-label">Settings</div>

                <a asp-area="Admin" asp-controller="HeroImage" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "HeroImage" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                    Hero Image
                </a>
                <a asp-area="Admin" asp-controller="Coupon" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Coupon" ? "active" : "")">
                    🎟️ Coupons
                </a>

                <a asp-area="Admin" asp-controller="User" asp-action="Index"
                   class="tc-sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" /></svg>
                    Users
                </a>
            </nav>

            <div class="tc-sidebar__footer">
                <a href="/">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" /></svg>
                    Back to Store
                </a>
                <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                    <button type="submit">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" /></svg>
                        Logout
                    </button>
                </form>
            </div>
        </aside>

        <div class="tc-sidebar-overlay" id="sidebarOverlay"></div>

        <!-- MAIN -->
        <div class="tc-admin-main">
            <header class="tc-admin-topbar">
                <div style="display:flex;align-items:center;gap:12px;">
                    <button class="tc-sidebar-toggle" id="sidebarToggle">
                        <span></span><span></span><span></span>
                    </button>
                    <span class="tc-admin-topbar__page">@ViewData["Title"]</span>
                </div>
                <div class="tc-admin-topbar__right">
                    <a href="/" class="tc-admin-topbar__store-link">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" /></svg>
                        View Store
                    </a>
                    <a asp-area="Customer" asp-controller="Profile" asp-action="Index" class="tc-admin-topbar__avatar">
                        @((User.Identity?.Name ?? "A").Substring(0, 1).ToUpper())
                    </a>
                </div>
            </header>

            <main class="tc-admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div id="toast" class="toast"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            (function () {
                var t = document.getElementById('toast');
                if (t) { t.textContent = '@Html.Raw(TempData["ToastMessage"])'; t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 3000); }
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (function () {
            var toggle = document.getElementById('sidebarToggle');
            var sidebar = document.getElementById('adminSidebar');
            var overlay = document.getElementById('sidebarOverlay');
            function open() { sidebar.classList.add('open'); overlay.style.display = 'block'; }
            function close() { sidebar.classList.remove('open'); overlay.style.display = 'none'; }
            if (toggle) toggle.addEventListener('click', open);
            if (overlay) overlay.addEventListener('click', close);
        })();
    </script>
</body>
</html>
