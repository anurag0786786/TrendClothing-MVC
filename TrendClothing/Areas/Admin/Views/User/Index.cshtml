@{
    ViewData["Title"] = "User Management";
}

<div class="row">
    <div class="col-9">
        <h2 class="text-primary">User List</h2>
    </div>
    <div class="col-3">
        <a asp-page="/Account/Register"
           asp-area="Identity"
           class="btn btn-info form-control">
            <i class="fas fa-plus"></i>&nbsp; New User
        </a>
    </div>
</div>

<div class="container rounded border p-2 mt-3">
    <table id="tblData" class="table table-bordered table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Action</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="~/js/user.js"></script>
}
