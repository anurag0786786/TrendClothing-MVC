@{
    ViewData["Title"] = "User Management";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tc-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="tc-container tc-admin-page">
    <div class="tc-admin-header">
        <div>
            <p class="tc-section-head__sub">Admin Panel</p>
            <h1 class="tc-admin-title">User Management</h1>
        </div>
        <a asp-area="Admin" asp-controller="User" asp-action="Create" class="tc-btn tc-btn--primary">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14" /></svg>
            New User
        </a>
    </div>

    <div class="tc-admin-card">
        <table id="tblData" class="tc-admin-table display" style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Action</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/user.js"></script>
}
