@{
    ViewData["Title"] = "User Management";
}

<!-- HEADER -->
<div class="row align-items-center mb-3">
    <div class="col-12 col-md-6">
        <h2 class="text-primary mb-2 mb-md-0">User List</h2>
    </div>

    <div class="col-12 col-md-6 text-md-end">
        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Create"
           class="btn btn-info w-100 w-md-auto">
            <i class="fas fa-plus"></i>&nbsp; New User
        </a>
    </div>
</div>

<!-- TABLE (DESKTOP & MOBILE SAFE) -->
<div class="container-fluid rounded border p-2 mt-3">

    <!-- Desktop Table -->
    <div class="table-responsive d-none d-md-block">
        <table id="tblData" class="table table-bordered table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th style="width:120px;">Action</th>
                </tr>
            </thead>
        </table>
    </div>

    <!-- Mobile Hint -->
    <div class="d-block d-md-none text-muted small text-center py-2">
        Swipe table left/right to see more →
    </div>

    <!-- Mobile Table (scrollable) -->
    <div class="table-responsive d-md-none">
        <table id="tblData" class="table table-bordered table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Action</th>
                </tr>
            </thead>
        </table>
    </div>

</div>

@section Scripts {
    <script src="~/js/user.js"></script>
}
