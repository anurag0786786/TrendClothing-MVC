@* Areas/Admin/Views/Coupon/Upsert.cshtml *@
@model TrendClothing.Models.Coupon
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Coupon" : "Edit Coupon";
}

<div class="container" style="max-width:520px;margin-top:40px;">
    <h2 style="font-family:var(--tc-font-display,serif);margin-bottom:24px;">
        @(Model.Id == 0 ? "Create Coupon" : "Edit Coupon")
    </h2>

    <form asp-action="Upsert" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="mb-3">
            <label class="form-label fw-600">Code <span class="text-danger">*</span></label>
            <input asp-for="Code" class="form-control text-uppercase" placeholder="e.g. SAVE20"
                   oninput="this.value=this.value.toUpperCase()" />
            <span asp-validation-for="Code" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-600">Discount Type <span class="text-danger">*</span></label>
            <select asp-for="DiscountType" class="form-select">
                <option value="Percent">Percent (%) — e.g. 20% off</option>
                <option value="Flat">Flat (₹) — e.g. ₹100 off</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-600">Discount Value <span class="text-danger">*</span></label>
            <input asp-for="DiscountValue" type="number" step="0.01" class="form-control"
                   placeholder="e.g. 20 for 20% or ₹20" />
            <span asp-validation-for="DiscountValue" class="text-danger small"></span>
            <div class="form-text">Percent type mein max 100 rakho</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-600">Minimum Order Amount (₹)</label>
            <input asp-for="MinOrderAmount" type="number" step="1" class="form-control"
                   placeholder="0 = no minimum" />
            <div class="form-text">0 rakho agar koi minimum nahi chahiye</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-600">Expiry Date</label>
            <input asp-for="ExpiryDate" type="date" class="form-control" />
            <div class="form-text">Khali chhodo agar expiry nahi chahiye</div>
        </div>

        <div class="mb-4">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="IsActive">Active</label>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-dark px-4">
                @(Model.Id == 0 ? "Create" : "Save Changes")
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
