@{
    ViewData["Title"] = "Product Variants";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Product Variants</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Upsert" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add Variant
            </a>
        </div>
    </div>

    <br />

    <table id="tblData" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Product</th>
                <th>Size</th>
                <th>Color</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Action</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="~/js/productVariant.js"></script>
}
