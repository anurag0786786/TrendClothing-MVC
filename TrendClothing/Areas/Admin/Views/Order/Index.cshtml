@{
    ViewData["Title"] = "Orders";
}

@section Styles {
    <style>
        /* ── STATUS FILTER TABS ── */
        .order-tabs {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }

        .order-tab {
            padding: 7px 18px;
            border-radius: 24px;
            font-size: 12px;
            font-weight: 700;
            font-family: var(--tc-font-body);
            border: 1.5px solid var(--tc-border-dark);
            background: var(--tc-surface);
            color: var(--tc-gray-2);
            cursor: pointer;
            transition: all 0.2s;
            letter-spacing: 0.3px;
        }

            .order-tab:hover,
            .order-tab.active {
                background: var(--tc-black);
                color: #fff;
                border-color: var(--tc-black);
            }

        /* ── STATUS BADGES ── */
        .os-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .os-approved {
            background: #e0f2e9;
            color: #2d6a4f;
        }

        .os-pending {
            background: #fffbeb;
            color: #b5830a;
        }

        .os-shipped {
            background: #eff6ff;
            color: #2563eb;
        }

        .os-inprocess {
            background: #f3f0ff;
            color: #6d28d9;
        }

        .os-delivered {
            background: #e0f2e9;
            color: #1a4731;
        }

        .os-cancelled {
            background: #fde8e0;
            color: #c1440e;
        }

        /* ── MODAL OVERLAY ── */
        .order-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

            .order-modal-overlay.open {
                display: flex;
            }

        .order-modal {
            background: var(--tc-surface);
            border-radius: var(--tc-radius-lg);
            width: 92%;
            max-width: 620px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--tc-shadow-lg);
            animation: modalIn 0.25s ease;
        }

        @@keyframes modalIn {
            from {
                transform: translateY(20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .order-modal__head {
            padding: 22px 24px 18px;
            border-bottom: 1px solid var(--tc-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            background: var(--tc-surface);
            z-index: 1;
        }

        .order-modal__title {
            font-family: var(--tc-font-display);
            font-size: 1.3rem;
            font-weight: 400;
            color: var(--tc-black);
        }

        .order-modal__close {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1.5px solid var(--tc-border-dark);
            background: none;
            font-size: 16px;
            color: var(--tc-gray-2);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

            .order-modal__close:hover {
                background: var(--tc-black);
                color: #fff;
                border-color: var(--tc-black);
            }

        .order-modal__body {
            padding: 24px;
        }

        /* ── INFO GRID ── */
        .order-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 24px;
        }

        .order-info-box {
            background: var(--tc-bg);
            border: 1px solid var(--tc-border);
            border-radius: var(--tc-radius-md);
            padding: 14px 16px;
        }

        .order-info-box__label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--tc-gray-3);
            margin-bottom: 5px;
        }

        .order-info-box__value {
            font-size: 14px;
            font-weight: 600;
            color: var(--tc-black);
            line-height: 1.4;
        }

        /* ── PRODUCTS IN ORDER ── */
        .order-product-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid var(--tc-border);
        }

            .order-product-row:last-child {
                border-bottom: none;
            }

        .order-product-img {
            width: 48px;
            height: 48px;
            border-radius: var(--tc-radius-sm);
            background: var(--tc-surface-alt);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            overflow: hidden;
        }

        .order-product-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--tc-black);
        }

        .order-product-meta {
            font-size: 11px;
            color: var(--tc-gray-3);
            margin-top: 2px;
        }

        .order-product-price {
            margin-left: auto;
            font-size: 13px;
            font-weight: 700;
            text-align: right;
        }

        /* ── STATUS UPDATE SECTION ── */
        .order-status-section {
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--tc-border);
        }

        .order-status-section__title {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--tc-gray-3);
            margin-bottom: 14px;
        }

        .order-status-btns {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 16px;
        }

        .status-update-btn {
            padding: 7px 16px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            font-family: var(--tc-font-body);
            border: 1.5px solid var(--tc-border-dark);
            background: var(--tc-surface);
            color: var(--tc-gray-1);
            cursor: pointer;
            transition: all 0.2s;
            letter-spacing: 0.3px;
        }

            .status-update-btn:hover:not(:disabled) {
                background: var(--tc-black);
                color: #fff;
                border-color: var(--tc-black);
            }

            .status-update-btn.current {
                background: var(--tc-black);
                color: #fff;
                border-color: var(--tc-black);
            }

            .status-update-btn:disabled {
                opacity: 0.35;
                cursor: not-allowed;
            }

        /* ── LOCK BANNERS ── */
        .lock-banner {
            border-radius: var(--tc-radius-md);
            padding: 12px 16px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .lock-banner--cancelled {
            background: #fde8e0;
            border: 1px solid #fcc7b0;
            color: #c1440e;
        }

        .lock-banner--delivered {
            background: #e0f2e9;
            border: 1px solid #b7dfc9;
            color: #2d6a4f;
        }

        /* Tracking row */
        .tracking-row {
            display: flex;
            gap: 8px;
            margin-top: 14px;
        }

            .tracking-row input {
                flex: 1;
                border: 1.5px solid var(--tc-border-dark);
                border-radius: var(--tc-radius-sm);
                padding: 8px 12px;
                font-size: 13px;
                font-family: var(--tc-font-body);
                background: var(--tc-surface);
                color: var(--tc-black);
                outline: none;
                transition: border-color 0.2s;
            }

                .tracking-row input:focus {
                    border-color: var(--tc-black);
                }

                .tracking-row input:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                }

            .tracking-row button {
                padding: 8px 16px;
                border-radius: var(--tc-radius-sm);
                background: var(--tc-black);
                color: #fff;
                border: none;
                font-size: 12px;
                font-weight: 700;
                font-family: var(--tc-font-body);
                cursor: pointer;
                transition: background 0.2s;
                white-space: nowrap;
            }

                .tracking-row button:hover:not(:disabled) {
                    background: var(--tc-gray-1);
                }

                .tracking-row button:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                }
    </style>
}

<div class="tc-admin-page">
    <div class="tc-container">

        <!-- ── HEADER ── -->
        <div class="tc-admin-header">
            <div>
                <div style="font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--tc-gray-3);margin-bottom:4px;">ADMIN</div>
                <h1 class="tc-admin-title">Orders</h1>
            </div>
        </div>

        <!-- ── STATUS FILTER TABS ── -->
        <div class="order-tabs">
            <button class="order-tab active" onclick="filterOrders('all', this)">All Orders</button>
            <button class="order-tab" onclick="filterOrders('pending', this)">Pending</button>
            <button class="order-tab" onclick="filterOrders('approved', this)">Approved</button>
            <button class="order-tab" onclick="filterOrders('inprocess', this)">Processing</button>
            <button class="order-tab" onclick="filterOrders('shipped', this)">Shipped</button>
            <button class="order-tab" onclick="filterOrders('delivered', this)">Delivered</button>
            <button class="order-tab" onclick="filterOrders('cancelled', this)">Cancelled</button>
        </div>

        <!-- ── TABLE ── -->
        <div class="tc-admin-card">
            <table id="tblOrders" class="tc-admin-table display" style="width:100%">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Phone</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

    </div>
</div>

<!-- ══ ORDER DETAILS MODAL ══ -->
<div class="order-modal-overlay" id="orderModal">
    <div class="order-modal">
        <div class="order-modal__head">
            <div class="order-modal__title" id="modalTitle">Order #</div>
            <button class="order-modal__close" onclick="closeModal()">✕</button>
        </div>
        <div class="order-modal__body" id="modalBody">
            <div style="text-align:center;padding:40px;color:var(--tc-gray-3);">
                <i class="fa-solid fa-circle-notch fa-spin"></i> Loading...
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.16/css/jquery.dataTables.min.css" />

    <script>
        var dataTable;
        var currentStatus = 'all';

        $(document).ready(function () {
            loadTable('all');
        });

        function loadTable(status) {
            if (dataTable) {
                dataTable.destroy();
                $('#tblOrders tbody').empty();
            }

            dataTable = $('#tblOrders').DataTable({
                ajax: { url: '/Admin/Order/GetAll?status=' + status },
                columns: [
                    {
                        data: 'id',
                        render: d => `<span style="font-weight:700;font-size:13px;">#${d}</span>`
                    },
                    {
                        data: 'name',
                        render: d => `<span style="font-weight:600;">${d || '—'}</span>`
                    },
                    { data: 'phoneNumber', render: d => d || '—' },
                    { data: 'orderDate' },
                    {
                        data: 'orderTotal',
                        render: d => `<span style="font-weight:700;">&#8377; ${Number(d).toLocaleString('en-IN')}</span>`
                    },
                    {
                        data: 'orderStatus',
                        render: d => {
                            const map = {
                                'Approved':  'os-approved',
                                'Pending':   'os-pending',
                                'Shipped':   'os-shipped',
                                'InTransit': 'os-shipped',
                                'InProcess': 'os-inprocess',
                                'Delivered': 'os-delivered',
                                'Cancelled': 'os-cancelled'
                            };
                            const cls = map[d] || 'os-pending';
                            return `<span class="os-badge ${cls}">${d}</span>`;
                        }
                    },
                    {
                        data: 'id',
                        render: d =>
                            `<button class="tc-admin-btn-edit" onclick="openModal(${d})">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                Details
                            </button>`
                    }
                ],
                order: [[0, 'desc']],
                language: {
                    emptyTable: 'No orders found',
                    zeroRecords: 'No matching orders'
                }
            });
        }

        function filterOrders(status, btn) {
            currentStatus = status;
            document.querySelectorAll('.order-tab').forEach(t => t.classList.remove('active'));
            btn.classList.add('active');
            loadTable(status);
        }

        // ── MODAL ──
        function openModal(orderId) {
            document.getElementById('modalTitle').textContent = 'Order #' + orderId;
            document.getElementById('modalBody').innerHTML =
                '<div style="text-align:center;padding:40px;color:var(--tc-gray-3);"><i class="fa-solid fa-circle-notch fa-spin"></i> Loading...</div>';
            document.getElementById('orderModal').classList.add('open');

            fetch('/Admin/Order/GetOrderDetails/' + orderId)
                .then(r => r.json())
                .then(data => renderModal(data))
                .catch(() => {
                    document.getElementById('modalBody').innerHTML =
                        '<div style="color:var(--tc-danger);padding:20px;">Could not load order details.</div>';
                });
        }

        function closeModal() {
            document.getElementById('orderModal').classList.remove('open');
        }

        document.getElementById('orderModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        function renderModal(d) {
            const isCancelled = d.orderStatus === 'Cancelled';
            const isDelivered = d.orderStatus === 'Delivered';
            const isLocked    = isCancelled || isDelivered;

            // Status options — Delivered last mein
            const statusOptions = ['Pending', 'Approved', 'InProcess', 'Shipped', 'Delivered', 'Cancelled'];

            var productsHtml = (d.items || []).map(p => `
                <div class="order-product-row">
                    <div class="order-product-img">
                        ${p.imageUrl
                            ? `<img src="${p.imageUrl}" style="width:100%;height:100%;object-fit:cover;">`
                            : '👕'}
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div class="order-product-name">${p.name}</div>
                        <div class="order-product-meta">Qty: ${p.count}</div>
                    </div>
                    <div class="order-product-price">
                        &#8377; ${Number(p.price * p.count).toLocaleString('en-IN')}
                        <div style="font-size:11px;color:var(--tc-gray-3);font-weight:400;">&#8377; ${Number(p.price).toLocaleString('en-IN')} each</div>
                    </div>
                </div>
            `).join('');

            // ✅ Lock banner — cancelled ya delivered
            var lockBanner = '';
            if (isCancelled) {
                lockBanner = `<div class="lock-banner lock-banner--cancelled">
                    <i class="fa-solid fa-ban"></i>
                    Yeh order cancel ho chuka hai — status change nahi ho sakta
                </div>`;
            } else if (isDelivered) {
                lockBanner = `<div class="lock-banner lock-banner--delivered">
                    <i class="fa-solid fa-circle-check"></i>
                    Order delivered ho chuka hai — status change nahi ho sakta
                </div>`;
            }

            // ✅ Buttons disable if locked
            var statusBtns = statusOptions.map(s => `
                <button class="status-update-btn ${d.orderStatus === s ? 'current' : ''}"
                        onclick="${isLocked ? '' : `updateStatus(${d.id}, '${s}', this)`}"
                        ${isLocked ? 'disabled' : ''}>
                    ${s}
                </button>
            `).join('');

            document.getElementById('modalBody').innerHTML = `
                <div class="order-info-grid">
                    <div class="order-info-box">
                        <div class="order-info-box__label">Customer</div>
                        <div class="order-info-box__value">${d.name || '—'}</div>
                    </div>
                    <div class="order-info-box">
                        <div class="order-info-box__label">Phone</div>
                        <div class="order-info-box__value">${d.phoneNumber || '—'}</div>
                    </div>
                    <div class="order-info-box">
                        <div class="order-info-box__label">Order Date</div>
                        <div class="order-info-box__value">${new Date(d.orderDate).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'})}</div>
                    </div>
                    <div class="order-info-box">
                        <div class="order-info-box__label">Order Total</div>
                        <div class="order-info-box__value">&#8377; ${Number(d.orderTotal).toLocaleString('en-IN')}</div>
                    </div>
                    <div class="order-info-box" style="grid-column:span 2;">
                        <div class="order-info-box__label">Delivery Address</div>
                        <div class="order-info-box__value">${d.streetAddress || ''}, ${d.city || ''}, ${d.state || ''} - ${d.postalCode || ''}</div>
                    </div>
                </div>

                <!-- Products -->
                <div style="font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--tc-gray-3);margin-bottom:12px;">Order Items</div>
                <div>${productsHtml || '<div style="color:var(--tc-gray-3);font-size:13px;">No items found</div>'}</div>

                <!-- Total -->
                <div style="display:flex;justify-content:flex-end;margin-top:14px;padding-top:12px;border-top:1px solid var(--tc-border);">
                    <div style="text-align:right;">
                        <div style="font-size:11px;color:var(--tc-gray-3);letter-spacing:1px;text-transform:uppercase;">Total</div>
                        <div style="font-family:var(--tc-font-display);font-size:1.5rem;">&#8377; ${Number(d.orderTotal).toLocaleString('en-IN')}</div>
                    </div>
                </div>

                <!-- Status Update -->
                <div class="order-status-section">
                    <div class="order-status-section__title">Update Order Status</div>
                    ${lockBanner}
                    <div class="order-status-btns" id="statusBtns_${d.id}">${statusBtns}</div>

                    <!-- Tracking -->
                    <div style="font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--tc-gray-3);margin-bottom:10px;margin-top:16px;">Tracking Info</div>
                    <div class="tracking-row">
                        <input type="text" id="carrierInput"  placeholder="Carrier (e.g. Delhivery)" value="${d.carrier || ''}" ${isLocked ? 'disabled' : ''}>
                        <input type="text" id="trackingInput" placeholder="Tracking Number" value="${d.trackingNumber && d.trackingNumber !== 'NA' ? d.trackingNumber : ''}" ${isLocked ? 'disabled' : ''}>
                        <button onclick="${isLocked ? '' : `updateTracking(${d.id})`}" ${isLocked ? 'disabled' : ''}>Save</button>
                    </div>
                </div>
            `;
        }

        function updateStatus(orderId, newStatus, btn) {
            $.post('/Admin/Order/UpdateStatus', { orderId, status: newStatus }, function(res) {
                if (res.success) {
                    document.querySelectorAll(`#statusBtns_${orderId} .status-update-btn`)
                        .forEach(b => b.classList.remove('current'));
                    btn.classList.add('current');
                    toastr.success('Status updated to ' + newStatus);
                    dataTable.ajax.reload(null, false);
                } else {
                    toastr.error(res.message);
                }
            });
        }

        function updateTracking(orderId) {
            var carrier  = document.getElementById('carrierInput').value;
            var tracking = document.getElementById('trackingInput').value;

            $.post('/Admin/Order/UpdateTracking', { orderId, carrier, trackingNumber: tracking }, function(res) {
                res.success ? toastr.success(res.message) : toastr.error(res.message);
            });
        }
    </script>
}
