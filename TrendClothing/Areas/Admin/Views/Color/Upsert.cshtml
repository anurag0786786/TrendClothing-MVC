@model TrendClothing.Models.Color
@{
    var title = Model.Id != 0 ? "Edit Color" : "New Color";
    var saveupdate = Model.Id != 0 ? "Update" : "Save";
    ViewData["Title"] = title;
}

<div class="tc-admin-form-wrap">
    <nav class="tc-breadcrumb">
        <a asp-action="Index">Colors</a>
        <span class="tc-breadcrumb__sep">/</span>
        <span class="tc-breadcrumb__current">@title</span>
    </nav>

    <h1 class="tc-admin-title" style="margin-bottom:28px;">@title</h1>

    <div class="tc-admin-card" style="max-width:560px;">
        <form method="post">
            @if (Model.Id != 0)
            {
                <input type="hidden" asp-for="@Model.Id" />
            }
            <div asp-validation-summary="ModelOnly" class="tc-admin-alert tc-admin-alert--error" style="margin-bottom:16px;"></div>

            <div class="tc-form-group">
                <label>Color Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Black, White, Navy Blue..." />
                <span asp-validation-for="Name" class="tc-admin-field-error"></span>
            </div>

            <div style="display:flex;gap:12px;margin-top:24px;">
                <button type="submit" class="tc-btn tc-btn--primary">@saveupdate</button>
                <a asp-action="Index" class="tc-btn tc-btn--outline">← Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
